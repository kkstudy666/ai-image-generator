# ===== 火山方舟 Seedream 配置 =====
# 在火山方舟控制台获取 API Key：https://console.volcengine.com/ark
ARK_API_KEY=在此填入你的火山方舟API_Key
# OpenAI 兼容接口地址（华北北京区域）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedream 模型 ID（带日期版本，需在控制台开通对应模型）
ARK_MODEL=doubao-seedream-5-0-pro-260628

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0
