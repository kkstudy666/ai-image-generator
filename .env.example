# ===== 火山方舟 Seedream 配置 =====
# 在火山方舟控制台获取 API Key：https://console.volcengine.com/ark
ARK_API_KEY=在此填入你的火山方舟API_Key
# OpenAI 兼容接口地址（华北北京区域）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedream 模型 ID（带日期版本，需在控制台开通对应模型）
ARK_MODEL=doubao-seedream-5-0-pro-260628
# 单次生图调用超时（秒）
SEEDREAM_TIMEOUT_SECONDS=60

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT 鉴权 =====
# 生产环境务必改成随机长字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=change-me-in-production
# token 有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ===== 限流（每分钟次数） =====
RATE_LIMIT_AUTH=10          # 登录/注册：IP 维度
RATE_LIMIT_API_IP=120       # 业务接口：IP 维度
RATE_LIMIT_API_USER=60      # 业务接口：用户维度

# ===== 熔断 =====
CB_FAILURE_THRESHOLD=5      # 连续失败 N 次打开熔断
CB_RECOVERY_SECONDS=60      # 熔断冷却期（秒）
